# ---------------------------------------------------------------
# Telegram Mini App backend (Vercel, or Render if you have a card on file)
# Copy to .env for local runs. Never commit the real .env file.
# On Vercel these are set in Project -> Settings -> Environment Variables.
# ---------------------------------------------------------------

# BotFather bot token, e.g. 123456789:AAExample...
TELEGRAM_BOT_TOKEN=""

# Bot username without the @, e.g. Crptflp_bot
TELEGRAM_BOT_USERNAME=""

# Mini App short name from BotFather (/newapp), e.g. flip.
# Invite links become https://t.me/<bot>/<name>?startapp=invite_<token>,
# which opens the app directly. Leave blank to fall back to a bot start link.
TELEGRAM_MINIAPP_NAME=""

# Supabase project settings
# Project Settings -> API
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY=""
# Service role key. Required: all tables use RLS with no policies, so the
# backend is the only thing allowed to read or write. Keep this server-side only.
SUPABASE_SERVICE_ROLE_KEY=""

# Public URL of this deployment, e.g. https://cflip.vercel.app
APP_URL=""

# Optional
PORT=3000
HOST=0.0.0.0
