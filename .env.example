# ---------------------------------------------------------------
# Telegram Mini App backend (Render)
# Copy to .env for local runs. Never commit the real .env file.
# ---------------------------------------------------------------

# BotFather bot token, e.g. 123456789:AAExample...
TELEGRAM_BOT_TOKEN=""

# Bot username without the @, e.g. cryptoflipbot
TELEGRAM_BOT_USERNAME=""

# Supabase project settings
# Project Settings -> API
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY=""
# Service role key. Required: all tables use RLS with no policies, so the
# backend is the only thing allowed to read or write. Keep this server-side only.
SUPABASE_SERVICE_ROLE_KEY=""

# Public URL of this deployment, e.g. https://cryptoflip.onrender.com
APP_URL=""

# Optional
PORT=3000
HOST=0.0.0.0
